APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Opcional: limitar sincronización PPD → periodo_ppds a estos curso_id (coma). Vacío = todos.
# PPD_PERIODOS_SYNC_CURSO_IDS=32,33

# Google Analytics 4 — ID de medición (formato G-XXXXXXXXXX).
# Crear propiedad en https://analytics.google.com — vacío = tracking desactivado.
# GOOGLE_ANALYTICS_ID=

# PukllaBot (RAG léxico + OpenRouter). 1) migrate knowledge_chunks  2) pukllabot:ingest --force
# Clave: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Por defecto: openrouter/free (router de modelos gratuitos; doc.openrouter.ai/docs/guides/routing/routers/free-models-router)
# Para un modelo :free concreto: https://openrouter.ai/models?pricing=free
# PUKLLABOT_OPENROUTER_MODEL=openrouter/free
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER="${APP_URL}"
# OPENROUTER_APP_NAME=PukllaBot
# PUKLLABOT_TOP_K=5
# PUKLLABOT_RETRIEVAL_MAX_CANDIDATES=180
# PUKLLABOT_LLM_MAX_TOKENS=600
# PUKLLABOT_OPENROUTER_TIMEOUT=75
# PUKLLABOT_OPENROUTER_CONNECT_TIMEOUT=12
# FAQs: umbral léxico por tema / entre temas (olvido de cambiar el desplegable)
# PUKLLABOT_FAQ_MIN_SCORE_SCOPE=2.75
# PUKLLABOT_FAQ_MIN_SCORE_CROSS=4
# PUKLLABOT_FAQ_CROSS_SCOPE=true
